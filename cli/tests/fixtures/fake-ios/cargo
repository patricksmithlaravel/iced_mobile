#!/bin/sh
# A fake `cargo` for icm's iOS tests: `metadata` runs the real cargo;
# `build` reports the synthetic executable in $ICM_FAKE_STATE/exe as the
# binary $ICM_FAKE_BIN (default fixture-app).
echo "$*" >> "$ICM_FAKE_STATE/cargo.log"
case "$1" in
metadata) exec "$ICM_REAL_CARGO" "$@" ;;
build)
  exe="$ICM_FAKE_STATE/exe"
  bin="${ICM_FAKE_BIN:-fixture-app}"
  printf '{"reason":"compiler-artifact","package_id":"%s 0.3.0","target":{"name":"%s","kind":["bin"]},"filenames":["%s"],"executable":"%s","fresh":false}\n{"reason":"build-finished","success":true}\n' "$bin" "$bin" "$exe" "$exe"
  ;;
clean) ;;
*)
  echo "fake cargo: unknown subcommand $1" >&2
  exit 1
  ;;
esac
