#!/bin/sh
# A fake `xcrun` for icm's ios-sim tests: actool and the simctl subcommands
# icm uses, with state in $ICM_FAKE_STATE. $ICM_FAKE_SCENARIO picks what the
# launched "app" does: `ok` (draws), `panic` (panics and exits) or `silent`
# (runs but sends no ICM_EVENT lines). `leak` draws and `leak-panic` panics
# like them, logging the secret in $ICM_TEST_API_TOKEN everywhere an app's
# output goes: stdout, stderr (plain, as JSON, in a URL with lowercase hex,
# as JSON with a \u escape after a log prefix), an ICM_EVENT warning, the
# ready event's fields of its own (`leak`), the unified log (`log stream`
# and `log show`, which write `/` as `\/`)
# and, for `leak-panic`, a crash report in ~/Library/Logs/DiagnosticReports.
#
# For the iOS release and ios-device tests it also fakes dsymutil (the
# dSYM's DWARF file is a copy of the executable, so its LC_UUID matches;
# ICM_FAKE_DSYM=empty writes no line table), dwarfdump --debug-line,
# strip, assetutil (ICM_FAKE_ICON=clear reports a transparent icon) and
# devicectl (devices from $S/devicectl-devices.json; `leak` and
# `leak-panic` log the secret on the console too; `device info processes`
# lists the app while its fake console runs, or what $S/processes.json says,
# and fails while $S/processes-fail exists).
S="$ICM_FAKE_STATE"
{
  echo "$*"
  env | grep '^SIMCTL_CHILD_\|^DEVICECTL_CHILD_' | sort | sed 's/^/  env /'
} >> "$S/xcrun.log"
# The secret the "app" logs: what `--env ICM_TEST_API_TOKEN=…` hands it
# (SIMCTL_CHILD_, DEVICECTL_CHILD_), else icm's own environment's. The
# launch records it in $S/app.token, as the device keeps what its app
# logged, so the log collector and a later `log show` (a command run
# without the secret) find it.
ICM_TEST_API_TOKEN=${SIMCTL_CHILD_ICM_TEST_API_TOKEN:-${DEVICECTL_CHILD_ICM_TEST_API_TOKEN:-${ICM_TEST_API_TOKEN:-}}}
# The forms the "app" logs it in.
tokens() {
  # JSON-escaped, and as Apple's `log` writes it; and the app's JSON line
  # `{"token":"<secret>"}` as `log` writes it.
  tok_json=$(printf '%s' "${ICM_TEST_API_TOKEN:-}" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
  tok_log=$(printf '%s' "$tok_json" | sed -e 's/\//\\\//g')
  json_log=$(printf '{"token":"%s"}' "$tok_json" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\//\\\//g')
  # In a URL with lowercase hex (for the characters the tests' secret
  # has), and as JSON with `\u002f` for `/` after a log prefix.
  tok_pct=$(printf '%s' "${ICM_TEST_API_TOKEN:-}" | sed -e 's/%/%25/g' -e 's/\//%2f/g' -e 's/"/%22/g' -e 's/\\/%5c/g')
  tok_u=$(printf '%s' "$tok_json" | sed -e 's/\//\\u002f/g')
}
# What the launch recorded, when this command was not given the secret.
launched_token() {
  if [ -z "$ICM_TEST_API_TOKEN" ] && [ -f "$S/app.token" ]; then
    ICM_TEST_API_TOKEN=$(cat "$S/app.token")
  fi
  tokens
}
tokens
# Ends the fake process $1, an `exec sleep 30.<its own pid>` (the command line
# names the pid, so no other process has it), only while the number still
# names that process: one that has ended may have left the number to another
# process, which a signal by number would hit.
end_fake() {
  [ "$(/bin/ps -p "$1" -o command= 2> /dev/null)" = "sleep 30.$1" ] && kill "$1"
  return 0
}
# One unified-log line of the app; $2 is its message as `log` writes it.
oslog_line() {
  printf '{"eventType":"logEvent","subsystem":"iced","category":"app","messageType":"Default","processID":%s,"processImagePath":"\\/data\\/Fixture.app\\/fixture-app","timestamp":"%s","eventMessage":"%s"}\n' \
    "${1:-0}" "$(date '+%Y-%m-%d %H:%M:%S.000000%z')" "$2"
}

tool="$1"
shift
case "$tool" in
actool)
  out=""
  partial=""
  while [ $# -gt 0 ]; do
    case "$1" in
    --compile) out="$2"; shift ;;
    --output-partial-info-plist) partial="$2"; shift ;;
    esac
    shift
  done
  mkdir -p "$out" && : > "$out/Assets.car"
  printf '<?xml version="1.0" encoding="UTF-8"?>\n<plist version="1.0"><dict><key>CFBundleIcons</key><dict/></dict></plist>\n' > "$partial"
  ;;
simctl)
  sub="$1"
  shift
  case "$sub" in
  list)
    case "$2" in
    runtimes) cat "$S/runtimes.json" ;;
    devicetypes) cat "$S/devicetypes.json" ;;
    devices)
      if [ -f "$S/created" ]; then cat "$S/devices-created.json"; else cat "$S/devices.json"; fi
      ;;
    esac
    ;;
  create)
    touch "$S/created"
    echo "FAKE-UDID"
    ;;
  boot | bootstatus | install | uninstall | delete | ui) ;;
  shutdown)
    # A shutdown clears the simulator's launchd environment.
    rm -f "$S/owner-$1"
    ;;
  getenv)
    # The launchd environment holds only what `launchctl setenv` put there
    # ($S/owner-<udid>); like simctl, an unset variable is a message on
    # stderr and exit 0. With $S/getenv-fails, it fails as simctl does
    # for a simulator it cannot ask.
    if [ -f "$S/getenv-fails" ]; then
      echo "An error was encountered processing the command (domain=com.apple.CoreSimulator.SimError, code=405):" >&2
      echo "Unable to getenv(\"$2\")" >&2
      exit 149
    fi
    if [ -f "$S/owner-$1" ]; then cat "$S/owner-$1"; else echo "'$2' not found" >&2; fi
    ;;
  spawn)
    udid="$1"
    shift
    case "$1" in
    log)
      case "$ICM_FAKE_SCENARIO" in leak*) leak=1 ;; *) leak="" ;; esac
      if [ "$2" = stream ]; then
        echo 'Filtering the log data using "fake"'
        if [ -n "$leak" ]; then
          # The collector starts before the launch: wait for the app.
          tries=0
          while [ -z "$ICM_TEST_API_TOKEN" ] && [ ! -s "$S/app.token" ] && [ "$tries" -lt 50 ]; do
            sleep 0.1
            tries=$((tries + 1))
          done
          launched_token
          oslog_line 0 "signed in with $tok_log"
          oslog_line 0 "$json_log"
          oslog_line 0 "GET https:\/\/api.example.com\/v1?lower=$tok_pct"
        fi
        exec sleep "20.$$"
      elif [ "$2" = show ] && [ -n "$leak" ]; then
        launched_token
        oslog_line "$(cat "$S/app.pid" 2> /dev/null)" "the system saw $tok_log"
      fi
      ;;
    launchctl)
      if [ "$2" = setenv ] && [ -f "$S/setenv-fails" ]; then
        # $S/setenv-fails: the spawn fails, as on a simulator simctl cannot reach.
        echo "An error was encountered processing the command (domain=com.apple.CoreSimulator.SimError, code=405):" >&2
        echo "Process spawn via launchd failed." >&2
        exit 149
      elif [ "$2" = setenv ]; then
        printf '%s\n' "$4" > "$S/owner-$udid"
      elif [ -f "$S/app.pid" ] && kill -0 "$(cat "$S/app.pid")" 2>/dev/null; then
        printf '%s\t0\tUIKitApplication:com.acme.fixture[1a2b][rb-legacy]\n' "$(cat "$S/app.pid")"
      fi
      ;;
    esac
    ;;
  launch)
    for arg in "$@"; do
      case "$arg" in
      --stderr=*) err="${arg#--stderr=}" ;;
      --stdout=*) out="${arg#--stdout=}" ;;
      esac
    done
    mkdir -p "$(dirname "$err")"
    : > "$out"
    printf '%s' "$ICM_TEST_API_TOKEN" > "$S/app.token"
    case "$ICM_FAKE_SCENARIO" in
    panic)
      sleep 1 > /dev/null 2>&1 &
      pid=$!
      printf 'ICM_EVENT {"v":1,"kind":"start","protocol":1,"pid":%s}\n\nthread '"'"'main'"'"' panicked at src/lib.rs:7:5:\nboom\n' "$pid" > "$err"
      ;;
    silent)
      nohup sh -c 'exec sleep "30.$$"' > /dev/null 2>&1 &
      pid=$!
      ;;
    leak | leak-panic)
      if [ "$ICM_FAKE_SCENARIO" = leak ]; then
        nohup sh -c 'exec sleep "30.$$"' > /dev/null 2>&1 &
      else
        sleep 1 > /dev/null 2>&1 &
      fi
      pid=$!
      printf 'signed in with %s\n' "$ICM_TEST_API_TOKEN" > "$out"
      {
        printf 'ICM_EVENT {"v":1,"kind":"start","protocol":1,"pid":%s}\n' "$pid"
        printf '{"token":"%s"}\n' "$tok_json"
        printf 'GET https://api.example.com/v1?lower=%s\n' "$tok_pct"
        printf 'INFO fixture: payload {"t":"%s"}\n' "$tok_u"
        printf 'ICM_EVENT {"v":1,"kind":"warning","code":"fixture.token","message":"token %s"}\n' "$tok_json"
        if [ "$ICM_FAKE_SCENARIO" = leak ]; then
          printf 'ICM_EVENT {"v":1,"kind":"ready","ms":5,"window":{"size":[402,874],"physical":[1206,2622],"scale":3,"title":"%s"},"backend":"wgpu","account":{"token":"%s"}}\n' "$tok_json" "$tok_json"
        else
          printf "\nthread 'main' panicked at src/lib.rs:7:5:\nrejected token %s\n" "$ICM_TEST_API_TOKEN"
        fi
      } > "$err"
      if [ "$ICM_FAKE_SCENARIO" = leak-panic ]; then
        reports="$HOME/Library/Logs/DiagnosticReports"
        mkdir -p "$reports"
        {
          echo '{"app_name":"fixture-app","bundleID":"com.acme.fixture","platform":7}'
          echo '{'
          printf '  "pid" : %s,\n' "$pid"
          echo '  "exception" : {"type":"EXC_CRASH","signal":"SIGABRT"},'
          printf '  "asi" : {"libsystem_c.dylib":["abort() called","rejected token %s"]}\n' "$tok_log"
          echo '}'
        } > "$reports/fixture-app-2026-10-07-120000.ips"
      fi
      ;;
    *)
      nohup sh -c 'exec sleep "30.$$"' > /dev/null 2>&1 &
      pid=$!
      printf 'ICM_EVENT {"v":1,"kind":"start","protocol":1,"pid":%s}\nICM_EVENT {"v":1,"kind":"ready","ms":5,"window":{"size":[402,874],"physical":[1206,2622],"scale":3},"backend":"wgpu"}\n' "$pid" > "$err"
      echo "hello from stdout" > "$out"
      ;;
    esac
    echo "$pid" > "$S/app.pid"
    echo "com.acme.fixture: $pid"
    ;;
  terminate)
    if [ -f "$S/app.pid" ]; then end_fake "$(cat "$S/app.pid")"; fi
    true
    ;;
  io)
    for arg in "$@"; do last="$arg"; done
    cp "$S/screen.png" "$last"
    ;;
  *)
    echo "fake xcrun: unknown simctl $sub" >&2
    exit 1
    ;;
  esac
  ;;
dsymutil)
  exe="$1"
  out="$3"
  name=$(basename "$exe")
  mkdir -p "$out/Contents/Resources/DWARF"
  cp "$exe" "$out/Contents/Resources/DWARF/$name"
  ;;
dwarfdump)
  # dwarfdump --debug-line <dSYM> -o <file>
  out="$4"
  if [ "$ICM_FAKE_DSYM" = empty ]; then
    : > "$out"
  else
    printf 'debug_line[0x00000000]\nLine table prologue:\n    version: 4\ninclude_directories[  1] = "library/core/src"\ninclude_directories[  2] = "src"\nfile_names[  1]:\n           name: "option.rs"\n      dir_index: 1\nfile_names[  2]:\n           name: "lib.rs"\n      dir_index: 2\n' > "$out"
  fi
  ;;
strip) ;;
assetutil)
  opaque=true
  if [ "$ICM_FAKE_ICON" = clear ]; then opaque=false; fi
  printf '[{"AssetStorageVersion":"fake"},{"AssetType":"Icon Image","Name":"AppIcon","PixelHeight":1024,"PixelWidth":1024,"Opaque":%s}]\n' "$opaque"
  ;;
devicectl)
  json=""
  dest=""
  prev=""
  for arg in "$@"; do
    case "$prev" in
    --json-output) json="$arg" ;;
    --destination) dest="$arg" ;;
    esac
    prev="$arg"
  done
  case "$1 $2" in
  "list devices") cp "$S/devicectl-devices.json" "$json" ;;
  "device install") printf '{"info":{"outcome":"success"},"result":{"installedApplications":[{"bundleID":"com.acme.fixture"}]}}\n' > "$json" ;;
  "device process")
    case "$3" in
    launch)
      case "$ICM_FAKE_SCENARIO" in
      panic)
        printf 'ICM_EVENT {"v":1,"kind":"start","protocol":1,"pid":4242}\n\nthread '"'"'main'"'"' panicked at src/lib.rs:7:5:\nboom\n'
        exit 0
        ;;
      leak-panic)
        printf 'ICM_EVENT {"v":1,"kind":"start","protocol":1,"pid":4242}\n'
        printf 'signed in with %s\n{"token":"%s"}\n' "$ICM_TEST_API_TOKEN" "$tok_json"
        printf "\nthread 'main' panicked at src/lib.rs:7:5:\nrejected token %s\n" "$ICM_TEST_API_TOKEN"
        exit 0
        ;;
      leak)
        echo $$ > "$S/device-app.pid"
        printf 'ICM_EVENT {"v":1,"kind":"start","protocol":1,"pid":4242}\n'
        printf 'signed in with %s\n{"token":"%s"}\n' "$ICM_TEST_API_TOKEN" "$tok_json"
        printf 'GET https://api.example.com/v1?lower=%s\n' "$tok_pct"
        printf 'INFO fixture: payload {"t":"%s"}\n' "$tok_u"
        printf 'ICM_EVENT {"v":1,"kind":"warning","code":"fixture.token","message":"token %s"}\n' "$tok_json"
        printf 'ICM_EVENT {"v":1,"kind":"ready","ms":5,"window":{"size":[402,874],"physical":[1206,2622],"scale":3,"title":"%s"},"backend":"wgpu","account":{"token":"%s"}}\n' "$tok_json" "$tok_json"
        exec sleep "30.$$"
        ;;
      *)
        echo $$ > "$S/device-app.pid"
        printf 'ICM_EVENT {"v":1,"kind":"start","protocol":1,"pid":4242}\nICM_EVENT {"v":1,"kind":"ready","ms":5,"window":{"size":[402,874],"physical":[1206,2622],"scale":3},"backend":"wgpu"}\n'
        exec sleep "30.$$"
        ;;
      esac
      ;;
    terminate)
      if [ -f "$S/device-app.pid" ]; then end_fake "$(cat "$S/device-app.pid")"; rm -f "$S/device-app.pid"; fi
      ;;
    esac
    ;;
  "device info")
    if [ -f "$S/processes-fail" ]; then
      # $S/processes-fail: devicectl cannot reach the device. It writes its
      # failure as JSON, and exits 1.
      printf '{"info":{"outcome":"failed"},"error":{"localizedDescription":"The device is not connected."}}\n' > "$json"
      echo "ERROR: The device is not connected." >&2
      exit 1
    elif [ -f "$S/processes.json" ]; then
      # $S/processes.json: what the device lists, whatever the "app" does.
      cp "$S/processes.json" "$json"
    elif [ -f "$S/device-app.pid" ] && kill -0 "$(cat "$S/device-app.pid")" 2> /dev/null; then
      # The app's executable inside its bundle is the binary icm built
      # ($ICM_FAKE_BIN, as the fake cargo names it).
      printf '{"result":{"runningProcesses":[{"executable":"file:///private/var/containers/Bundle/Application/X/Fixture.app/%s","processIdentifier":4242}]}}\n' "${ICM_FAKE_BIN:-fixture-app}" > "$json"
    else
      printf '{"result":{"runningProcesses":[]}}\n' > "$json"
    fi
    ;;
  "device capture") cp "$S/screen.png" "$dest" ;;
  *)
    echo "fake xcrun: unknown devicectl $*" >&2
    exit 1
    ;;
  esac
  ;;
*)
  echo "fake xcrun: unknown tool $tool" >&2
  exit 1
  ;;
esac
